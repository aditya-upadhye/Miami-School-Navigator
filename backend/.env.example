# ---------------- LLM for the chat agent (any OpenAI-compatible /chat/completions endpoint with tool calling) ----------------
# Default: Gemma 4 through Google's OpenAI-compatible Gemini API endpoint. Get a key at https://aistudio.google.com/apikey
# Secrets live in the environment only; never commit this file with a real key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemma-4-26b-a4b-it     # default for gemini (gemma-4-31b-it is also listed but was not responding when tested); e.g. a Gemini Flash model id to upgrade quality
# LLM_BASE_URL=                     # override the provider preset
# LLM_API_KEY=                      # generic key (takes priority over GEMINI_API_KEY / GROQ_API_KEY / ...)
# Backups on OTHER providers, tried in order when the main model fails. provider:model[@max calls per UTC day]; each uses its own key.
# Paid providers (cerebras, openai, together, openrouter) default to 600 calls a day; @0 = no cap.
# LLM_BACKUPS=nvidia:google/gemma-4-31b-it,cerebras:qwen-3.8-27b@600   # needs NVIDIA_API_KEY and CEREBRAS_API_KEY
# CEREBRAS_API_KEY=
LLM_TEMPERATURE=0.1                 # low temperature per the spec; leave empty to use the model default
# LLM_RPM=15                       # client-side requests/minute cap (0 = off)
# LLM_TPM=14000                    # client-side tokens/minute cap; Google's free Gemma tier is 16K/min and a chat turn can use 15-25K
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=90
# LLM_SYSTEM_MODE=auto              # auto | system | fold  (fold = put instructions in the first user message)
# LLM_EXTRA_BODY={"reasoning_effort": "low"}   # JSON merged into every request, for provider-specific options

# ---- other providers (examples) ----
# Hosted open model:  LLM_PROVIDER=groq        GROQ_API_KEY=...        LLM_MODEL=<model id>
#                     LLM_PROVIDER=openrouter  OPENROUTER_API_KEY=...  LLM_MODEL=<model id>
#                     LLM_PROVIDER=together    TOGETHER_API_KEY=...    LLM_MODEL=<model id>
# Local, no key:      LLM_PROVIDER=ollama      LLM_MODEL=<ollama model tag>      (http://localhost:11434/v1)
#                     LLM_PROVIDER=vllm        LLM_MODEL=<served model name>     (http://localhost:8000/v1)
# Anything else:      LLM_PROVIDER=custom      LLM_BASE_URL=https://host/v1  LLM_API_KEY=...  LLM_MODEL=...

# ---------------- Service ----------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
AUTO_INGEST=true
# Accounts (family sign-in, saved schools). Separate from the school database so a rebuild never deletes them.
# USERS_DB_PATH=data/users.db
# COOKIE_SECURE=true        # set on https deployments
# COOKIE_SAMESITE=lax       # "none" (with COOKIE_SECURE=true) when the frontend is on a different site
