# Leave empty in development: Vite proxies /api to http://localhost:8000 (override with API_PROXY_TARGET).
# For a deployed build, set the public URL of the backend, e.g. https://navigator-api.example.com
VITE_API_BASE_URL=

# 3D map: free OpenFreeMap vector tiles (OpenStreetMap data, no key). Their public server is for light use: for real traffic point these at a
# hosted TileJSON in the OpenMapTiles schema (and its font glyphs), and set the attribution that provider requires.
# VITE_MAP_TILES_URL=https://tiles.openfreemap.org/planet
# VITE_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# VITE_MAP_ATTRIBUTION=<a href="https://openfreemap.org">OpenFreeMap</a> &copy; OpenMapTiles data from OpenStreetMap
