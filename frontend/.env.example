# Leave empty in development: Vite proxies /api to http://localhost:8000 (override with API_PROXY_TARGET).
# For a deployed build, set the public URL of the backend, e.g. https://navigator-api.example.com
VITE_API_BASE_URL=

# Map tiles. Default: OpenStreetMap's public tile server (light use only). For real traffic use a tile provider or your own server.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
